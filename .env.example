# Copy to .env and fill in. All settings use the AGENTCREW_ prefix.

# ---- Model ----------------------------------------------------------------
AGENTCREW_PROVIDER=anthropic
AGENTCREW_ANTHROPIC_API_KEY=sk-ant-...
# AGENTCREW_PROVIDER=openai
# AGENTCREW_OPENAI_API_KEY=sk-...
# AGENTCREW_MODEL=claude-sonnet-4-5-20250929
AGENTCREW_TEMPERATURE=0.0

# ---- Budgets (loop control) -----------------------------------------------
AGENTCREW_MAX_ATTEMPTS_PER_STEP=3
AGENTCREW_MAX_STEPS=4
AGENTCREW_MAX_LLM_CALLS=30
AGENTCREW_MAX_SQL_EXECUTIONS=24
AGENTCREW_WALL_CLOCK_SECONDS=180

# ---- Safety ---------------------------------------------------------------
# Leave false. The database handle is opened read-only regardless; this only
# controls whether the AST guard permits write statements at all.
AGENTCREW_ALLOW_WRITE_MODE=false

# ---- Cost and abuse guard (public demo, server key) ------------------------
# Runs and model calls per UTC day across every session on the server's key.
# 0 = no cap. Resets on a cold start. A visitor's own key is never counted.
AGENTCREW_DAILY_RUN_CAP=150
AGENTCREW_DAILY_LLM_CALL_CAP=1000
AGENTCREW_DAILY_UPLOAD_CAP=50

# ---- Bring your own data (docs/DATA_SOURCES.md) ----------------------------
AGENTCREW_UPLOADS_ENABLED=true
AGENTCREW_MAX_UPLOAD_MB=10
AGENTCREW_MAX_EXCEL_UPLOAD_MB=10
AGENTCREW_UPLOAD_STORE_MAX_MB=150
AGENTCREW_DATASET_TTL_SECONDS=900
# Self-hosted only (docs/SELF_HOSTED.md): answer from your own PostgreSQL
# database as a read-only role. Never set this on a public deployment.
# AGENTCREW_DATABASE_URL=postgresql://agentcrew_ro:PASSWORD@host:5432/company
# AGENTCREW_DESCRIPTIONS_PATH=/descriptions/descriptions.yaml

# A browser session with no activity for this long is ended, in the browser
# and on the server, so an idle tab cannot keep the Cloud Run instance alive.
AGENTCREW_IDLE_TIMEOUT_SECONDS=600

# ---- Observability --------------------------------------------------------
# Always on: one JSON line per run on stdout (agentcrew/runlog.py), and the
# original agent's JSONL traces in data/traces/.
# Langfuse is an optional extra: on as soon as both keys are set. Set
# AGENTCREW_LANGFUSE_ENABLED=false to switch it off while keeping the keys.
# AGENTCREW_LANGFUSE_PUBLIC_KEY=pk-lf-...
# AGENTCREW_LANGFUSE_SECRET_KEY=sk-lf-...
# AGENTCREW_LANGFUSE_HOST=https://cloud.langfuse.com
# Off by default and off on the public demo. When true, the run log line and
# the Langfuse trace also hold the question text and the final SQL, so a
# self-hosted operator can see real failures. Result rows and uploaded data
# are never recorded either way.
AGENTCREW_TRACE_CONTENT=false
